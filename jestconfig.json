{
  "testEnvironment": "node",
  "testMatch": ["**/*.test.ts"],
  "moduleFileExtensions": ["ts", "js", "json", "node"],
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.ts$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript"
          },
          "target": "es2022"
        },
        "module": {
          "type": "es6"
        }
      }
    ]
  }
}
